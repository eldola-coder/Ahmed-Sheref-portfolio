.projects-github-link {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 12px;
  color: #dbe8f2;
  text-decoration: none;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 10px;
  background: rgba(255,255,255,.025);
  font-size: 13px;
  font-weight: 600;
  transition: all .25s ease;
}
.projects-github-link:hover {
  border-color: rgba(31,162,255,.32);
  background: rgba(31,162,255,.08);
  color: #fff;
  transform: translateY(-2px);
}
.projects-footer-link { display: none !important; }

.university-image-visual {
  min-height: 230px;
  padding: 18px;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 20%, rgba(31,162,255,.12), transparent 42%),
    linear-gradient(145deg, rgba(15,19,24,.97), rgba(8,11,15,.99));
}
.university-image-visual > img {
  width: min(165px, 42%);
  max-height: 190px;
  object-fit: contain;
  display: block;
  filter: drop-shadow(0 12px 24px rgba(0,0,0,.35));
}
.education-image-label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-left: 28px;
  max-width: 310px;
}
.education-image-label strong {
  color: #fff;
  font-size: 28px;
  line-height: 1.1;
}
.education-image-label span {
  color: var(--muted);
  line-height: 1.5;
}
.education-source {
  display: block;
  margin-top: 14px;
  color: rgba(154,160,166,.7);
  font-size: 10px;
}
.achievement-visual {
  background: #fff;
}
.achievement-visual img {
  object-fit: contain;
  background: #fff;
  padding: 6px;
}

@media (max-width: 1000px) {
  #projects .section-head {
    align-items: flex-start;
  }
}
@media (max-width: 700px) {
  #projects .section-head {
    display: block;
  }
  .projects-github-link {
    margin-top: 14px;
  }
  .university-image-visual {
    flex-direction: column;
    text-align: center;
  }
  .university-image-visual > img {
    width: 130px;
  }
  .education-image-label {
    margin: 14px 0 0;
    align-items: center;
  }
  .education-image-label strong {
    font-size: 23px;
  }
}


/* --- V8: cleaner hero + focused education --- */
#home .hero-left {
  max-width: 560px;
}
#home .hero-lead {
  max-width: 540px;
  margin-top: 18px;
  font-size: clamp(17px, 1.8vw, 20px);
  line-height: 1.65;
}
#home .hero-actions {
  margin-top: 26px;
}
#home .hero-photo-card {
  animation: heroCardFloat 6s ease-in-out infinite;
  will-change: transform;
}
#home .hero-photo-card:hover {
  animation-play-state: paused;
  transform: translateY(-4px) scale(1.01);
}
@keyframes heroCardFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}
#home .profile-card-copy {
  padding: 18px 20px 20px;
}
#home .profile-card-copy > strong {
  font-size: 24px;
}
.hero-mini-meta {
  margin: 2px 0 4px;
  color: var(--muted);
  font-size: 13px;
}
.compact-socials {
  margin-top: 7px;
}
.compact-socials a {
  padding: 8px 10px;
}

#education .education-intro {
  margin-bottom: 20px;
}
.education-single {
  grid-template-columns: 1fr;
}
.university-only-card {
  display: grid;
  grid-template-columns: minmax(280px, .85fr) 1.15fr;
  min-height: 330px;
}
.university-only-card .education-visual {
  min-height: 100%;
  border-right: 1px solid rgba(255,255,255,.05);
}
.university-only-card .education-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 30px;
}
.education-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 12px;
  margin-top: 18px;
}
.education-detail-item {
  padding: 13px 14px;
  border-radius: 10px;
  background: rgba(255,255,255,.025);
  border: 1px solid rgba(255,255,255,.045);
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.education-detail-item span {
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .7px;
}
.education-detail-item strong {
  color: var(--white);
  font-size: 15px;
}
@media (max-width: 850px) {
  .university-only-card {
    grid-template-columns: 1fr;
  }
  .university-only-card .education-visual {
    border-right: 0;
    border-bottom: 1px solid rgba(255,255,255,.05);
  }
}
@media (max-width: 620px) {
  .education-detail-grid { grid-template-columns: 1fr; }
}
