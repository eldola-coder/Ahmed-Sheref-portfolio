.project-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: none;
  place-items: center;
  padding: 20px;
}
.project-modal.is-open { display: grid; }
.project-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(3,5,7,.78);
  backdrop-filter: blur(12px);
  animation: modalFade .22s ease both;
}
.project-modal-dialog {
  position: relative;
  z-index: 2;
  width: min(900px, 96vw);
  max-height: min(820px, 90vh);
  overflow: auto;
  display: grid;
  grid-template-columns: minmax(280px,.9fr) minmax(0,1.1fr);
  background: #121417;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 18px;
  box-shadow: 0 40px 100px rgba(0,0,0,.65);
  animation: modalRise .28s cubic-bezier(.2,.9,.2,1) both;
}
.project-modal-close {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 4;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,.1);
  background: rgba(8,10,13,.76);
  color: white;
  cursor: pointer;
  font-size: 17px;
}
.project-modal-media { min-height: 100%; background: #0b0d10; overflow: hidden; border-radius: 18px 0 0 18px; }
.project-modal-media img { width: 100%; height: 100%; min-height: 470px; object-fit: cover; display: block; }
.project-modal-content { padding: 34px 30px 30px; }
.project-modal-topline { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
.project-modal-topline span { padding: 5px 8px; border-radius: 999px; font-size: 11px; background: rgba(31,162,255,.08); color: #9fd7ff; border: 1px solid rgba(31,162,255,.12); }
.project-modal-content h2 { font-size: 28px; margin: 0 0 10px; }
.project-modal-content > p { color: var(--muted); line-height: 1.7; }
.project-modal-content h3 { margin: 24px 0 10px; font-size: 14px; }
.project-modal-content ul { color: #c9cdd2; padding-left: 18px; line-height: 1.65; }
.project-modal-content li + li { margin-top: 7px; }
.project-modal-links { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 9px; }
body.modal-open { overflow: hidden; }
@keyframes modalFade { from { opacity: 0; } to { opacity: 1; } }
@keyframes modalRise { from { opacity: 0; transform: translateY(18px) scale(.985); } to { opacity: 1; transform: none; } }

@media (max-width: 760px) {
