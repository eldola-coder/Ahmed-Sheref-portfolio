.project-media {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #0b0d10;
  border-bottom: 1px solid rgba(255,255,255,.045);
}
.project-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .55s cubic-bezier(.2,.9,.2,1), filter .55s ease;
}
.project-card:hover .project-media img { transform: scale(1.035); filter: saturate(1.06) contrast(1.02); }
.project-media::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 50%, rgba(5,7,10,.58));
  pointer-events: none;
}
.project-media-overlay {
  position: absolute;
